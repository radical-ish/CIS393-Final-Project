<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="style.css" />
    <title>Randomized Fun Facts!</title>
  </head>
  <body>
    <div class="container">
      <h1>
        Random (possibly inaccurate, biased, and curated) Fun Fact Generator
      </h1>
    </div>
    <nav id="navbar">
        <a href="/index.html">Home</a>
        <a href="/generate">Generate</a>
        <a href="/suggestions.html">Suggestions</a>
        <a href="/about.html">About</a>
        <div></div>
        <a href="/articles">Articles</a>
        <a href="/suggestionData">Suggestion Table</a>
        <div></div>
      </nav>
    <table>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Source</th>
            <th>Favorite Color</th>
        </tr>
        <% for(let i = 0; i < result.length; i++){ %>
            <tr>
                <td><%=result[i].id%></td>
                <td><%=result[i].name%></td>
                <td><%=result[i].description%></td>
                <td><%=result[i].source%></td>
                <td><div class="color" style="background-color: <%=result[i].colorHex%>"></div></td>
                <td>
                    <a href="/suggestionData/delete/<%=result[i].id%>""><button>Delete</button></a>
                </td>
            </tr>
        <% } %>
    </table>
  </body>
</html>